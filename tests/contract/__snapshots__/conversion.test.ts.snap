exports[`contract: history and tool conversion per provider > Anthropic tools (all four workspace tools) 1`] = `
[
  {
    "description": "Read a UTF-8 text file inside the working directory. Returns numbered lines. Use offset/limit for large files.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Maximum number of lines to return.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "description": "First line to return (1-based).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "path": {
          "description": "File path, relative to the working directory.",
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
    "name": "read_file",
  },
  {
    "description": "List files and folders inside the working directory. Folders end with "/". node_modules, .git and build outputs are skipped.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Directory path relative to the working directory. Defaults to ".".",
          "type": "string",
        },
        "recursive": {
          "description": "List subdirectories recursively (depth-limited).",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "list_directory",
  },
  {
    "description": "Create or overwrite a text file inside the working directory with the given full content. The user must approve the change.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "Full new content of the file (UTF-8). Overwrites the file if it exists.",
          "type": "string",
        },
        "path": {
          "description": "File path, relative to the working directory.",
          "type": "string",
        },
      },
      "required": [
        "path",
        "content",
      ],
      "type": "object",
    },
    "name": "write_file",
  },
  {
    "description": "Run a shell command inside the working directory and return its combined output and exit code. The user must approve every command.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Shell command line to run.",
          "minLength": 1,
          "type": "string",
        },
        "cwd": {
          "description": "Working directory for the command, relative to the workspace. Defaults to the workspace root.",
          "type": "string",
        },
      },
      "required": [
        "command",
      ],
      "type": "object",
    },
    "name": "run_command",
  },
]
`;

