exports[`contract: history and tool conversion per provider > Anthropic messages 1`] = `
[
  {
    "content": "Summarize notes.txt and then list the folder",
    "role": "user",
  },
  {
    "content": [
      {
        "text": "Let me look.",
        "type": "text",
      },
      {
        "id": "call_read",
        "input": {
          "path": "notes.txt",
        },
        "name": "read_file",
        "type": "tool_use",
      },
      {
        "id": "call_ls",
        "input": {
          "path": ".",
          "recursive": false,
        },
        "name": "list_directory",
        "type": "tool_use",
      },
    ],
    "role": "assistant",
  },
  {
    "content": [
      {
        "content": "1	hello notes",
        "is_error": false,
        "tool_use_id": "call_read",
        "type": "tool_result",
      },
      {
        "content": "path outside workspace",
        "is_error": true,
        "tool_use_id": "call_ls",
        "type": "tool_result",
      },
    ],
    "role": "user",
  },
  {
    "content": [
      {
        "text": "The file says hello.",
        "type": "text",
      },
    ],
    "role": "assistant",
  },
]
`;

exports[`contract: history and tool conversion per provider > Anthropic tools (all tools incl. ask_user) 1`] = `
[
  {
    "description": "Read a UTF-8 text file inside the working directory. Returns numbered lines. Use offset/limit for large files.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Maximum number of lines to return.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "description": "First line to return (1-based).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "path": {
          "description": "File path, relative to the working directory.",
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
    "name": "read_file",
  },
  {
    "description": "List files and folders inside the working directory. Folders end with "/". node_modules, .git and build outputs are skipped.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Directory path relative to the working directory. Defaults to ".".",
          "type": "string",
        },
        "recursive": {
          "description": "List subdirectories recursively (depth-limited).",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "list_directory",
  },
  {
    "description": "Create or overwrite a text file inside the working directory with the given full content. May require user approval depending on the approval mode.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "Full new content of the file (UTF-8). Overwrites the file if it exists.",
          "type": "string",
        },
        "path": {
          "description": "File path, relative to the working directory.",
          "type": "string",
        },
      },
      "required": [
        "path",
        "content",
      ],
      "type": "object",
    },
    "name": "write_file",
  },
  {
    "description": "Run a shell command inside the working directory and return its combined output and exit code. May require user approval depending on the approval mode.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Shell command line to run.",
          "minLength": 1,
          "type": "string",
        },
        "cwd": {
          "description": "Working directory for the command, relative to the workspace. Defaults to the workspace root.",
          "type": "string",
        },
      },
      "required": [
        "command",
      ],
      "type": "object",
    },
    "name": "run_command",
  },
  {
    "description": "Use this tool when you need a decision from the user to continue: choosing an approach, picking a file, confirming an understanding, learning a preference. Do not use it to approve file writes or commands — those are handled by the user's approval mode. Offer concrete, mutually exclusive options with a short description each; the user can always select "Other" to type a free answer. Set multiSelect: true when several answers may apply. If you recommend an option, make it the first one and append "(Recommended)" to its label. Ask at most a few questions per call; the user answers them one at a time and you receive all answers together.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "questions": {
          "description": "Questions to ask, answered one at a time.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "header": {
                "description": "Very short label shown as a tag (max 12 chars).",
                "maxLength": 12,
                "minLength": 1,
                "type": "string",
              },
              "multiSelect": {
                "description": "Allow the user to select several options (default false).",
                "type": "boolean",
              },
              "options": {
                "description": "The choices offered; the user can always pick "Other" and type a free answer.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "description": "One line explaining what choosing it means.",
                      "minLength": 1,
                      "type": "string",
                    },
                    "label": {
                      "description": "Short label of the choice, shown to the user.",
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "label",
                    "description",
                  ],
                  "type": "object",
                },
                "maxItems": 4,
                "minItems": 2,
                "type": "array",
              },
              "question": {
                "description": "The complete question to ask the user.",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "question",
              "header",
              "options",
            ],
            "type": "object",
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "questions",
      ],
      "type": "object",
    },
    "name": "ask_user",
  },
]
`;

exports[`contract: history and tool conversion per provider > OpenAI-compatible messages 1`] = `
[
  {
    "content": "SYSTEM",
    "role": "system",
  },
  {
    "content": "Summarize notes.txt and then list the folder",
    "role": "user",
  },
  {
    "content": "Let me look.",
    "role": "assistant",
    "tool_calls": [
      {
        "function": {
          "arguments": "{"path":"notes.txt"}",
          "name": "read_file",
        },
        "id": "call_read",
        "type": "function",
      },
      {
        "function": {
          "arguments": "{"path":".","recursive":false}",
          "name": "list_directory",
        },
        "id": "call_ls",
        "type": "function",
      },
    ],
  },
  {
    "content": "1	hello notes",
    "role": "tool",
    "tool_call_id": "call_read",
  },
  {
    "content": "ERROR: path outside workspace",
    "role": "tool",
    "tool_call_id": "call_ls",
  },
  {
    "content": "The file says hello.",
    "role": "assistant",
  },
]
`;

