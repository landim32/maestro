exports[`Markdown renderer — snapshots (80 columns) > mixed-real-answer.md with color 1`] = `
"Como funciona o loop
════════════════════

O loop de ferramentas faz três coisas:

1. Envia o histórico ao provedor
2. Recebe tool_call e valida o input com zod
3. Executa e reenvia

Exemplo mínimo:

╭──────────────────────────────────────────────────────────────────────────────╮
│ typescript                                                                   │
│ for (;;) {                                                                   │
│   const r = await provider.stream(req);                                      │
│   if (r.stop !== "tool_use") break;                                          │
│ }                                                                            │
╰──────────────────────────────────────────────────────────────────────────────╯

┌────────────┬───────────────┐
│ Evento     │ Efeito        │
├────────────┼───────────────┤
│ text_delta │ acumula texto │
│ tool_call  │ enfileira     │
└────────────┴───────────────┘

│ Nota: no modo -p nada disso é formatado.

────────────────────────────────────────────────────────────────────────────────

Pronto!"
`;

exports[`Markdown renderer — snapshots (80 columns) > mixed-real-answer.md without color 1`] = `
"Como funciona o loop
════════════════════

O loop de ferramentas faz três coisas:

1. Envia o histórico ao provedor
2. Recebe \`tool_call\` e valida o input com \`zod\`
3. Executa e reenvia

Exemplo mínimo:

╭──────────────────────────────────────────────────────────────────────────────╮
│ typescript                                                                   │
│ for (;;) {                                                                   │
│   const r = await provider.stream(req);                                      │
│   if (r.stop !== "tool_use") break;                                          │
│ }                                                                            │
╰──────────────────────────────────────────────────────────────────────────────╯

┌────────────┬───────────────┐
│ Evento     │ Efeito        │
├────────────┼───────────────┤
│ text_delta │ acumula texto │
│ tool_call  │ enfileira     │
└────────────┴───────────────┘

│ Nota: no modo \`-p\` nada disso é formatado.

────────────────────────────────────────────────────────────────────────────────

Pronto!"
`;

