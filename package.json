{
  "name": "maestro",
  "version": "0.3.0",
  "description": "Maestro — multi-model AI assistant for the terminal (future agent orchestrator)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/landim32/maestro.git"
  },
  "type": "module",
  "bin": {
    "maestro": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/version.mjs --write dist/version.json",
    "dev": "node scripts/version.mjs --write src/version.json && tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude tests/integration/ui/perf.test.tsx && npm run test:perf",
    "test:perf": "vitest run tests/integration/ui/perf.test.tsx",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "version:print": "node scripts/version.mjs",
    "version:json": "node scripts/version.mjs --json",
    "version:sync": "node scripts/version.mjs --sync-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "chalk": "^6.0.1",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "ink-gradient": "^4.0.1",
    "lowlight": "^3.3.0",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^8.3.0",
    "unified": "^11.0.5",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
